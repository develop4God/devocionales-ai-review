# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=

# LangSmith tracing — optional, but recommended: auto-traces every graph node and
# model call to smith.langchain.com, no code changes needed. Get a free key at
# smith.langchain.com (Settings -> API Keys).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=content-batch-graph
